---
/** A numbered strip of the "minimal facts" accepted by most historians. */
import { LinkButton } from '@astrojs/starlight/components';
import Section from './Section.astro';

const facts = [
	{ fact: 'Jesus died by crucifixion.', note: 'Attested by Christian and non-Christian sources alike.' },
	{ fact: 'His disciples believed He rose and appeared to them.', note: 'They said so early, and suffered for saying it.' },
	{ fact: 'Paul, a persecutor of the church, was suddenly changed.', note: 'He became its most famous missionary.' },
	{ fact: 'James, a skeptical brother, was suddenly changed.', note: 'He became a leader of the church in Jerusalem.' },
	{ fact: 'The tomb was empty.', note: 'Even the critics of the day assumed it.' },
];
---

<Section
	eyebrow="Where history points"
	title="These are <em>the facts</em>."
	lede="Historians — including skeptical ones — widely accept a short list of facts about what happened after Jesus’ death. Any explanation has to account for all of them."
>
	<ol class="facts">
		{
			facts.map(({ fact, note }, i) => (
				<li>
					<span class="n tc-display">{String(i + 1).padStart(2, '0')}</span>
					<div>
						<p class="fact tc-display">{fact}</p>
						<p class="note">{note}</p>
					</div>
				</li>
			))
		}
	</ol>
	<div class="actions">
		<LinkButton href="/evidence/minimal-facts/" icon="right-arrow">The minimal facts</LinkButton>
		<LinkButton href="/evidence/explanations/" variant="minimal" icon="right-arrow">
			Compare the explanations
		</LinkButton>
	</div>
</Section>

<style>
	.facts {
		list-style: none;
		padding: 0;
		max-width: 46rem;
		margin-inline: auto;
		display: grid;
	}
	li {
		display: grid;
		grid-template-columns: 3.5rem 1fr;
		gap: 1rem;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--tc-border);
	}
	li:first-child {
		border-top: 1px solid var(--tc-border);
	}
	.n {
		font-size: 2rem;
		line-height: 1;
		font-weight: 600;
		color: var(--sl-color-accent);
		font-variant-numeric: lining-nums;
	}
	.fact {
		font-size: var(--sl-text-xl);
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	.note {
		margin-top: 0.25rem;
		color: var(--sl-color-gray-3);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem 1.5rem;
		margin-top: 2.5rem;
	}
</style>
